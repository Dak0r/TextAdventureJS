      "actions": {
        "pickup": {
          "text": [
            "Okay got it."
          ],
          "commands": [
            "objectRemoveFromLocation this",
            "inventoryAdd template_object_pickedUp"
          ]
        },
        "look": {
          "text": [
            "A mysterious object."
          ],
          "commands": []
        }
      },
      "useableObjects": {}
    },
    "template_object_pickedUp": {
      "words": [
        "object",
        "obj"
      ],
      "locationDescription": "An object is lying on the floor.",
      "actions": {
        "drop": {
          "text": [
            "Okay dropped it."
          ],
          "commands": [
            "objectAddToLocation template_object",
            "inventoryRemove this"
          ]
        },
        "look": {
          "text": [
            "A mysterious object."
          ],
          "commands": []
        }
      },
