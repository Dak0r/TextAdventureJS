      "words": ["desk", "desktop", "workingplace"],
      "locationDescription": "",
      "actions": {
        "pickup": {
          "text": ["okay got it"],
          "commands": ["inventoryAdd template_object"]
        },
        "look": {
          "text": ["soft and comfy"],
          "commands": []
        }
      },
      "useableObjects": {
        "bedroom_desk": {
          "text": ["soft and comfy"],
          "commands": []
